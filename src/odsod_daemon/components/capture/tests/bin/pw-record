#!/usr/bin/env python3
"""A fake ``pw-record`` for tests.

``FAKE_PW_RECORD_SCRIPT`` is a JSON list of steps:

- ``{"count": 10, "value": 7, "delay": 0.1}``: write 10 blocks of 3,200
  bytes of that int16 sample, one every delay.
- ``{"pause": 5}``: write nothing for that many seconds.
- ``{"exit": 3}``: exit with that code.

Without an ``exit`` step the process stays alive and silent after the
script, so a test can see a stall. ``FAKE_PW_RECORD_LOG`` gets one line per
run with the arguments, so a test can check the stream properties.
"""

import json
import os
import sys
import time

BLOCK_BYTES = 3_200


def blocks(value: int, count: int, delay: float) -> None:
    sample = int(value).to_bytes(2, "little", signed=True) * (BLOCK_BYTES // 2)
    for _ in range(count):
        sys.stdout.buffer.write(sample)
        sys.stdout.buffer.flush()
        time.sleep(delay)


def main() -> int:
    log = os.environ.get("FAKE_PW_RECORD_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(sys.argv[1:]) + "\n")
    script = json.loads(os.environ.get("FAKE_PW_RECORD_SCRIPT", "[]"))
    for step in script:
        if "exit" in step:
            return int(step["exit"])
        if "pause" in step:
            time.sleep(float(step["pause"]))
            continue
        blocks(
            int(step.get("value", 0)),
            int(step.get("count", 1)),
            float(step.get("delay", 0.1)),
        )
    while True:
        time.sleep(1)


if __name__ == "__main__":
    sys.exit(main())
