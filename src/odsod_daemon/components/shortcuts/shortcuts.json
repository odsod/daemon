    },
    {
      "actionId": ["kwin", "[odsod] debug", "KWin", ""],
      "key": "Meta+;",
      "kind": "debug"
    },
    {
      "actionId": ["kwin", "[odsod] mullvad-browser", "KWin", ""],
      "key": "Meta+b",
      "kind": "app",
      "command": ["mullvad-browser"],
      "resourceClass": "Mullvad Browser"
    },
    {
      "actionId": ["kwin", "[odsod] qbittorrent", "KWin", ""],
