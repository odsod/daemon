[Unit]
Description=odsod daemon session
OnFailure=odsod-daemon-notify@%n.service
StartLimitIntervalSec=60
StartLimitBurst=5
After=pipewire.service wireplumber.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=notify
BusName=io.github.odsod.daemon.session
ExecStopPost={{odsodctl}} unmute-stale
ExecStart={{odsodctl}} run session
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
