#!/bin/sh
set -eu
if [ "${FAKE_GCC_FAIL:-0}" = "1" ]; then
  echo "fake gcc: boom" >&2
  exit 1
fi
out=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [ -z "$out" ]; then
  echo "fake gcc: no -o" >&2
  exit 1
fi
mkdir -p "$(dirname "$out")"
printf 'fake keys binary %s\n' "${FAKE_GCC_CONTENT:-one}" > "$out"
chmod 755 "$out"
if [ -n "${FAKE_LOG:-}" ]; then
  printf 'gcc %s\n' "$out" >> "$FAKE_LOG/gcc.log"
fi
