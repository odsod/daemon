[Unit]
Description=odsod-daemon keys remapper
After=systemd-udevd.service
Wants=systemd-udevd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
RuntimeDirectory=odsod-daemon-keys
RuntimeDirectoryMode=0755
ExecStartPre=/bin/sh -c 'mkdir -p /run/odsod-daemon-keys && chown {{uid}}:{{gid}} /run/odsod-daemon-keys'
ExecStart=/usr/local/bin/odsod-daemon-keys
Restart=always
RestartSec=1
Nice=-20

[Install]
WantedBy=multi-user.target
