[Unit]
Description=odsod-daemon keys remapper
After=systemd-udevd.service
Wants=systemd-udevd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Made here, not by systemd: systemd sets its own runtime dir owner again
# before ExecStart, and the socket gets the owner of this directory.
ExecStartPre=/bin/sh -c 'mkdir -p -m 0755 /run/odsod-daemon-keys && chown {{uid}}:{{gid}} /run/odsod-daemon-keys'
ExecStart=/usr/local/bin/odsod-daemon-keys
Restart=always
RestartSec=1
Nice=-20

[Install]
WantedBy=multi-user.target
